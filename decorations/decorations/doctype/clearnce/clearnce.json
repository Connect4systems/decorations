{
 "doctype": "DocType",
 "name": "Clearnce",
 "module": "Decorations",
 "engine": "InnoDB",
 "field_order": [
  "date",
  "project",
  "customer",
  "company",
  "currency",
  "costs",
  "total_cost",
  "supervision_percent",
  "supervision",
  "total_amount",
  "sales_invoice",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "default": "Today",
   "reqd": 1
  },
  {
   "fieldname": "project",
   "fieldtype": "Link",
   "label": "Project",
   "options": "Project",
   "reqd": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "fetch_from": "project.customer",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "fetch_from": "project.company",
   "read_only": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "costs",
   "fieldtype": "Table",
   "label": "Costs",
   "options": "Clearnce Cost",
   "reqd": 1
  },
  {
   "fieldname": "total_cost",
   "fieldtype": "Currency",
   "label": "Total Cost",
   "read_only": 1,
   "options": "currency"
  },
  {
   "fieldname": "supervision_percent",
   "fieldtype": "Percent",
   "label": "Supervision %",
   "fetch_from": "project.custom_supervision",
   "read_only": 1
  },
  {
   "fieldname": "supervision",
   "fieldtype": "Currency",
   "label": "Supervision",
   "read_only": 1,
   "options": "currency"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1,
   "options": "currency"
  },
  {
   "fieldname": "sales_invoice",
   "fieldtype": "Link",
   "label": "Sales Invoice",
   "options": "Sales Invoice",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Clearnce",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "share": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "is_submittable": 1,
 "autoname": "format:CLR-{YYYY}-{#####}"
}
